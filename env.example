# The keys Hypnos reads. Copy this file to .env in the same folder and write each key after
# its "=", with no spaces and no quotes:   cp env.example .env
# .env stays on this computer: git ignores it. Never commit it, never share it, never paste it
# into a chat.

# Deepgram: the band's microphone as text (the Microphone switch in the Live tab).
DEEPGRAM_API_KEY=

# Google (an API key from AI Studio): nothing reads it yet. For the agent, when it is built in.
GOOGLE_API_KEY=

# ElevenLabs: nothing reads it yet. Optional, for the agent's voice.
ELEVENLABS_API_KEY=
